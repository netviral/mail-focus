{
    "manifest_version": 3,
    "name": "Gmail Priority Filter",
    "description": "Dims all Gmail emails except selected important senders.",
    "version": "1.1",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://mail.google.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*"
            ],
            "matches": [
                "https://mail.google.com/*"
            ]
        }
    ]
}